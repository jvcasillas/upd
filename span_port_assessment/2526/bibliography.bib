@article{pallier_et_al_1993,
	title = {Attentional allocation within the syllabic structure of spoken words.},
	volume = {32},
	issn = {1096-0821(Electronic),0749-596X(Print)},
	doi = {10.1006/jmla.1993.1020},
	abstract = {Explored the role of the syllable during on-line speech perception in 5 experiments with a total of 60 Parisian university students and 112 Spanish undergraduates. A variant of the phoneme decision task developed by M. A. Pitt and A. G. Samuel (see record 1991-06403-001) was employed. French and Spanish Ss had to detect targets (appended) that appeared either in the coda of the 1st syllable or in the onset of the 2nd syllable of carrier words. Ss' expectations about the structural position of the target were manipulated (using a decision or a detection paradigm). Ss who attended to the coda of the 1st syllable were faster when the target appeared in this position rather than in the onset of the 2nd syllable; the reverse pattern was observed when Ss attended to the onset of the 2nd syllable. Findings suggest that syllabic information is specified as a prelexical level of representation. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
	number = {3},
	journal = {Journal of Memory and Language},
	author = {Pallier, Christophe and Sebastian-Gallés, Núria and Felguera, Teodora and Christophe, Anne and Mehler, Jacques},
	year = {1993},
	note = {Place: Netherlands
Publisher: Elsevier Science},
	keywords = {Language, *Syllables, *Attention, *Reaction Time, *Speech Perception},
	pages = {373--389},
}



@article{kolinsky_et_al_1995,
	title = {Intermediate representations in spoken word recognition: {Evidence} from word illusions.},
	volume = {34},
	issn = {1096-0821(Electronic),0749-596X(Print)},
	doi = {10.1006/jmla.1995.1002},
	abstract = {Examined unconscious perceptual representations in speech through the detection (Exps 1 and 2) or spontaneous aural identification (Exp 3) of illusory words created by blending 2 dichotic stimuli. Different speech properties were compared by manipulating information between 2 inputs (e.g., initial consonant, or 1st vowel). 39 undergraduates participated in Exp 1, 16 in Exp 2, and 24 in Exp 3. Illusory word targets were more frequently experienced when the distribution corresponds to syllables than when it corresponded to either the initial consonant (and its phonetic features) or the 1st vowel. Illusory words were also more frequent when the distribution corresponded to syllables than when it did not correspond to any obvious phonological property. Moreover, in the identification task, illusory percepts only involved syllable combinations. The results suggest a new paradigm for uncovering speech perceptual codes. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
	number = {1},
	journal = {Journal of Memory and Language},
	author = {Kolinsky, Régine and Morais, José and Cluytens, Mireille},
	year = {1995},
	note = {Place: Netherlands
Publisher: Elsevier Science},
	keywords = {*Illusions (Perception), *Oral Communication, Word Recognition},
	pages = {19--40},
}



@article{laks_1995,
	title = {A connectionist account of {French} syllabification},
	volume = {95},
	issn = {0024-3841},
	url = {https://www.sciencedirect.com/science/article/pii/0024384195901019},
	doi = {https://doi.org/10.1016/0024-3841(95)90101-9},
	abstract = {In this paper, we present a connectionist approach to phonology. We show that a process like syllabification, which in a symbolic framework is generally thought of as being the outcome of some kind of parsing by a dedicated algorithm, can be accounted for in a pure dynamic way. In this approach, syllables and syllabic constituency are by no means primitives and the labelling of syllable parts is not axiomatic. They are the by-product of the linear integration process of segments. In other words, syllables are not the building parts of words. On the contrary, in as much as words are made of sounds, given the dynamic properties of those sounds and in particular their tendency to interact in a continuous manner, our model predicts that the aggregation of sounds will give rise to self-organized processes from which syllables and syllabic constituents finally emerge. The universality of syllabic organisation in human languages is thus given a materialistic, quasi-phonetic grounding.},
	number = {1},
	journal = {Lingua},
	author = {Laks, Bernard},
	year = {1995},
	pages = {51--76},
	annote = {French Phonology},
}


