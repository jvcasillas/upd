@article{harris_1955,
	title = {From phoneme to morpheme},
	volume = {31},
	doi = {10.2307/411036},
	abstract = {"This paper presents a method for counting at each phonemic position n of a test utterance, all the phonemes that occur in the (n + 1)th place (in any utterances) after the particular string of phonemes from the beginning of the test utterance up to n. When this count is made for each n of the utterance, it is found to rise and fall a number of times. If we segment the test utterance after each peak, we will find that the cuts accord very well with the word boundaries and quite well with the morpheme boundaries of that utterance." "… this method could have led to the discovery of morpheme-like segments, even if we had not known otherwise that morphemes exist… . The method… can be viewed as part of an orderly set of kindred methods capable of yielding a large part of language structure in terms of the relative occurrences of sounds… ." (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
