@article{dupoux_hammond_1994,
	title = {Are stress units used in prelexical processing in {English}?},
	abstract = {Previous investigations have claimed that speech perception uses languagespeci c strategies and that, in particular, English does not use a strategy based on syllables (Cutler, Mehler, Norris, and Segui, 1983 1986). This conclusion is based on a failure to replicate the interaction between target type and word type in fragment monitoring experiments that was originaly found in French (Mehler et ,al. 1981) with English subjects and materials. Here, we explore the possibility that this might be due to one of three related hypotheses: i) syllable boundaries in English depend on the stress value of the following syllable ii) English listeners use the foot instead of the syllable in speech perception iii) English subjects posit a perceptual boundary before an unreduced (or {\textbackslash}strong") syllable but not before a reduced, or {\textbackslash}weak" one. These three hypotheses can all be tested on the basis of the same contrasts and so we group them together under the rubric of {\textbackslash}stress-sensitive strategies" (SSSs). In Experiment 1, we nd some incomplete support for a SSS, but the e ect is not replicated in subsequent Experiments 2 (with slowed-down subjects) and 3 (with a di erent set of materials). An associated o -line task (Experiment 4) reveals that, according to subjects' intuitions, syllables have a rather di erent structure than we assumed at the outset. We conclude by rejecting these SSSs as the major source of the di erence between French and English. In the nal section, we discuss the possibility that the English perceptual system might still be based on the syllable, but not a stress-sensitive one.},
	language = {en},
	author = {Dupoux, E and Hammond, Michael},
	year = {1994},
	file = {Dupoux and Hammond - Are StPrersosceUssniintgs UinseEdnginlisPhrelexic.pdf:/Users/juanjogp/Zotero/storage/5XWAVD9V/Dupoux and Hammond - Are StPrersosceUssniintgs UinseEdnginlisPhrelexic.pdf:application/pdf},
}

@article{holt_lotto_2008,
