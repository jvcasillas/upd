}

@article{taft_hambly_1986,
	title = {Exploring the cohort model of spoken word recognition},
	volume = {22},
	issn = {0010-0277},
	url = {https://www.sciencedirect.com/science/article/pii/001002778690017X},
	doi = {10.1016/0010-0277(86)90017-X},
	abstract = {Predictions derived from the Cohort Model of spoken word recognition were tested in four experiments using an auditory lexical decision task. The first experiment produced results that were compatible with the model, in that the point at which a word could be uniquely identified appeared to influence reaction times. The second and third experiments demonstrated that the processing of a nonword phoneme string continues after the point at which there are no possible continuations that would make a word. The number of phonemes following the point of deviation from a word was shown to affect reaction times, as well as the similarity of the nonword to a word. The final experiment demonstrated a frequency effect when high and low frequency words were matched on their point of unique identity. These last three results are not consistent with the Cohort Model and so an alternative account is put forward. According to this account, the first few phonemes are used to activate all words beginning with those phonemes and then these candidates are checked back to the original stimulus. This model provides greater flexibility than the Cohort Model and allows for mispronounced and misperceived words to be correctly recognized.
Résumé
Quatre expériences utilisant une tâche de decision lexicale auditive ont permis de tester certaines prédictions du modèle de reconnaissance des mots dit “de la cohorte”. La premiere expérience a produit des résultats compatibles avec le modèle, puisque le point de reconnaissance d'un mot semblait influer sur les temps de réponse. La deuxième et la troisième expérience ont démontré que, dans le cas de non-mots, l'analyse de la séquence de phonèmes se poursuivait au delà du point à partir duquel il n'existait plus de continuation possible, et que le nombre de phonemes après ce point influait sur les temps de réponse. La dernière expérience a mis en évidence un effet de fréquence lorsque des mots fréquents et peu fréquents avaient le même point de reconnaissance. Ces trois derniers resultats sont incompatibles avec le modele de la cohorte, et un modèle différent est donc proposé. Selon ce modèle, les premiers phonemes servent à activer tous les mots dont ils constituent la séquence initiale, et ces différentes possibilités sont ensuite comparées au stimulus original. Ce modèle a l'avantage d'être plus souple que le modele de la cohorte; il explique aussi que des mots mal prononcés et mal perçus puissent être correctement reconnus.},
	language = {en},
	number = {3},
	urldate = {2021-10-13},
	journal = {Cognition},
	author = {Taft, Marcus and Hambly, Gail},
	month = apr,
	year = {1986},
	pages = {259--282},
	file = {ScienceDirect Full Text PDF:/Users/juanjogp/Zotero/storage/YK6RDX5J/Taft and Hambly - 1986 - Exploring the cohort model of spoken word recognit.pdf:application/pdf},
}

@article{cleland_etal_2006,
	title = {Frequency effects in spoken and visual word recognition: {Evidence} from dual-task methodologies},
	volume = {32},
	issn = {1939-1277},
	shorttitle = {Frequency effects in spoken and visual word recognition},
	doi = {10.1037/0096-1523.32.1.104},
	abstract = {The authors report 3 dual-task experiments concerning the locus of frequency effects in word recognition. In all experiments, Task 1 entailed a simple perceptual choice and Task 2 involved lexical decision. In Experiment 1, an underadditive effect of word frequency arose for spoken words. Experiment 2 also showed underadditivity for visual lexical decision. It was concluded that word frequency exerts an influence prior to any dual-task bottleneck. A related finding in similar dual-task experiments is Task 2 response postponement at short stimulus onset asynchronies. This was explored in Experiment 3, and it was shown that response postponement was equivalent for both spoken and visual word recognition. These results imply that frequency-sensitive processes operate early and automatically. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
