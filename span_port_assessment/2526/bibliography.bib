@article{brent_cartwright_1996,
	title = {Distributional regularity and phonotactic constraints are useful for segmentation},
	volume = {61},
	issn = {1873-7838},
	doi = {10.1016/S0010-0277(96)00719-6},
	abstract = {Examined the effectiveness of distributional regularity (DR) and phonotactic constraints for segmenting broad phonetic transcripts of child-directed English in 4 experiments. The method was computer simulation of the proposed strategies, using phonetic transcripts of child-directed speech as input. A specific algorithm for optimizing DR functions was designed, implemented as a computer program, and its performance was measured on a model of the child's segmentation task. The results show that DR functions and phonotactic constraints are largely independent, so using both yields better segmentation than using either one alone. Learning the permissible word-boundary clusters from utterance boundaries does not degrade segmentation performance. Appendices of the representational system, word-initial and word-final consonant clusters are provided. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
