@article{schiller_etal_1997,
	title = {The syllabic structure of spoken words: {Evidence} from the syllabification of intervocalic consonants},
	volume = {40},
	issn = {1756-6053},
	shorttitle = {The syllabic structure of spoken words},
	abstract = {Investigated the syllable affiliation of intervocalic consonants following short vowels, long vowels, and schwa in Dutch. Special interest was paid to words like letter, in which a short vowel is followed by a single intervocalic consonant. Ss were 97 university students who were native speakers of Dutch. Bisyllabic word forms were presented aurally, and Ss produced their syllables in reversed order (Exps 1– 5), or repeated the words inserting a pause between the syllables (Exp 6). Results showed that Ss generally closed syllables with a short vowel. However, in a significant number of the cases they produced open short vowel syllables. Syllables containing schwa, like syllables with a long vowel, were hardly ever closed. Word stress, the phonetic quality of the vowel in the first syllable, and the experimental context influenced syllabification. Taken together, the experiments show that native speakers syllabify bisyllabic Dutch nouns in accordance with a small set of prosodic output constraints. To account for the variability of the results, it is proposed that these constraints differ in their probabilities of being applied. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
	number = {2},
