	file = {Submitted Version:/Users/jgarridopozu/Zotero/storage/2CT2V4Y6/Schepens et al. - 2012 - Distributions of cognates in Europe as based on Le.pdf:application/pdf},
}

@article{schepens_cross-language_2013,
