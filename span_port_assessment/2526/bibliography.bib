}


@article{gaskell_marslen-wilson_1997,
	title = {Integrating form and meaning: {A} distributed model of speech perception},
	volume = {12},
	issn = {1464-0732(Electronic),0169-0965(Print)},
	shorttitle = {Integrating form and meaning},
	doi = {10.1080/016909697386646},
	abstract = {Presents a distributed connectionist model of the perception of spoken words. The model employs a representation of speech that combines lexical information with abstract phonological information, with lexical access modelled as a direct mapping onto this single distributed representation. The integration of partial cues to phonological identity is examined, showing that the model provides a sound basis for simulating phonetic and lexical decision data from W. Marslen-Wilson and P. Warren (1994). The time course of lexical access is also investigated, and it is argued that the process of competition between word candidates during lexical access can be interpreted in terms of interference between distributed lexical representations. The relation between this model and other models of spoken word recognition is discussed. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
	number = {5-6},
