	pages = {167--176},
	file = {Roelofs and Verhoef - 2006 - Modeling the control of phonological encoding in b.pdf:/Users/juanjogp/Zotero/storage/MBUFLMS5/Roelofs and Verhoef - 2006 - Modeling the control of phonological encoding in b.pdf:application/pdf},
}

