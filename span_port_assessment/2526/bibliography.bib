@article{lacross_et_al_2016,
	title = {The role of stress and word size in {Spanish} speech segmentation},
	volume = {140},
	issn = {0001-4966},
	url = {http://asa.scitation.org/doi/10.1121/1.4971227},
	doi = {10.1121/1.4971227},
	abstract = {In English, the predominance of stressed syllables as word onsets aids lexical segmentation in degraded listening conditions. Yet it is unlikely that these ﬁndings would readily transfer to languages with differing rhythmic structure. In the current study, the authors seek to examine whether listeners exploit both common word size (syllable number) and stress cues to aid lexical segmentation in Spanish. Fortyseven Spanish-speaking listeners transcribed two-word Spanish phrases in noise. As predicted by the statistical probabilities of Spanish, error analysis revealed that listeners preferred two- and three-syllable words with penultimate stress in their attempts to parse the degraded speech signal. These ﬁndings provide insight into the importance of stress in tandem with word size in the segmentation of Spanish words and suggest testable hypotheses for cross-linguistic studies that examine the effects of degraded acoustic cues on lexical segmentation.},
	language = {en},
	number = {6},
	urldate = {2020-11-27},
	journal = {The Journal of the Acoustical Society of America},
	author = {LaCross, Amy and Liss, Julie and Barragan, Beatriz and Adams, Ashley and Berisha, Visar and McAuliffe, Megan and Fromont, Robert},
	month = dec,
	year = {2016},
	pages = {EL484--EL490},
	file = {LaCross et al. - 2016 - The role of stress and word size in Spanish speech.pdf:/Users/juanjogp/Zotero/storage/UZHCM3JQ/LaCross et al. - 2016 - The role of stress and word size in Spanish speech.pdf:application/pdf},
