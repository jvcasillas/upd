@article{finn_hudson_2008,
	title = {The curse of knowledge: {First} language knowledge impairs adult learners’ use of novel statistics for word segmentation},
	volume = {108},
	issn = {0010-0277},
	shorttitle = {The curse of knowledge},
	url = {https://www.sciencedirect.com/science/article/pii/S001002770800098X},
	doi = {10.1016/j.cognition.2008.04.002},
	abstract = {We investigated whether adult learners’ knowledge of phonotactic restrictions on word forms from their first language impacts their ability to use statistical information to segment words in a novel language. Adults were exposed to a speech stream where English phonotactics and phoneme co-occurrence information conflicted. A control where these did not conflict was also run. Participants chose between words defined by novel statistics and words that are phonotactically possible in English, but had much lower phoneme contingencies. Control participants selected words defined by statistics while experimental participants did not. This result held up with increases in exposure and when segmentation was aided by telling participants a word prior to exposure. It was not the case that participants simply preferred English-sounding words, however, when the stimuli contained very short pauses, participants were able to learn the novel words despite the fact that they violated English phonotactics. Results suggest that prior linguistic knowledge can interfere with learners’ abilities to segment words from running speech using purely statistical cues at initial exposure.},
	language = {en},
	number = {2},
	urldate = {2022-02-25},
	journal = {Cognition},
	author = {Finn, Amy S. and Hudson Kam, Carla L.},
	month = aug,
	year = {2008},
	keywords = {Language acquisition, Learning constrains, Phonotactics, Second language learning, Statistical learning, Transitional probabilities},
	pages = {477--499},
	file = {ScienceDirect Snapshot:/Users/juanjogp/Zotero/storage/BKKK936C/S001002770800098X.html:text/html},
}

@misc{bagou_etal_2002,
	title = {Contribution of {Prosody} to the {Segmentation} and {Storage} of "{Words}" in the {Acquisition} of a {New} {Mini}-{Language}},
	abstract = {This paper evaluates the relative contribution of two prosodic cues, lengthening and f0 contour, in the processes of speech segmentation and storage of new words. More precisely, we investigate the role of prosodic information in the acquisition by French learners of a mini-language constructed for the experiment. The results show that presence of prosodic information facilitates the speech segmentation and therefore, the acquisition of the new language. Indeed, lengthening or f0 rise on the word final syllable is used by listeners to infer the presence of a boundary. However, the presence of the two cues manipulated does not improve performance; and when only one cue is present, f0 induces slightly more accurate segmentation than lengthening. Finally, the storage of the "stressable" property of the word-final syllables in French is discussed.},
	author = {Bagou, Odile and Fougeron, Cécile and Frauenfelder, Uli H.},
	year = {2002},
	file = {Citeseer - Full Text PDF:/Users/juanjogp/Zotero/storage/UVNGT4ZS/Bagou et al. - 2002 - Contribution of Prosody to the Segmentation and St.pdf:application/pdf;Citeseer - Snapshot:/Users/juanjogp/Zotero/storage/TG4WAR2T/download.html:text/html},
