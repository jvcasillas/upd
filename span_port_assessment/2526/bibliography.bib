@article{mills_1980,
	title = {Effects of the match between listener expectancies and coarticulatory cues on the perception of speech},
	volume = {6},
	issn = {1939-1277},
	doi = {10.1037/0096-1523.6.3.528},
	abstract = {Several experiments have attempted to establish the order in which various linguistic units (e.g., syllables and words) are processed. This article presents an alternative interpretation (the target-stimulus mismatch interpretation) for those earlier results. This interpretation states that the closer the match between the listener's expectancies about how the stimulus will sound (the target) and the sound of the acoustic stimulus the listener actually hears (the stimulus), the faster the listener will recognize the stimulus. This interpretation was tested with 40 undergraduates in an experiment in which the match between the target and the stimulus was varied by manipulating the acoustic (coarticulatory) properties of the stimulus while the size of the target (syllable) was held constant. Results suggest that earlier findings explained in terms of linguistic units or levels can be explained more readily by the target-stimulus mismatch interpretation. Findings provide evidence that coarticulatory information is utilized by the perceiver of speech. (20 ref) (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
	number = {3},
	journal = {Journal of Experimental Psychology: Human Perception and Performance},
	author = {Mills, Carol B.},
	year = {1980},
	note = {Place: US
Publisher: American Psychological Association},
	keywords = {Auditory Perception, Expectations, Speech Perception},
	pages = {528--535},
	file = {Snapshot:/Users/juanjogp/Zotero/storage/99KVN954/1981-20406-001.html:text/html},
}

@article{mcneill_lindig_1973,
	title = {The perceptual reality of phonemes, syllables, words, and sentences},
	volume = {12},
	issn = {0022-5371},
	doi = {10.1016/S0022-5371(73)80020-9},
	abstract = {Argues that experiments in which listeners detect the presence of phonemes or syllables in lists of syllables are meaningless for determining the perceptual units of speech. An experiment was conducted with 96 13-50 yr old listeners, in which results demonstrate that the minimum reaction time (RT) in such experiments occurs whenever the linguistic level of the target and the search list is the same. It is stressed that, since this level is determined by the experimental design, it is impossible to use the occurrence of minimum RT to identify perceptual units. Theoretical questions raised by monitoring experiments include the strategies used in searching lists for targets and the phenomenon of linguistic "transparency," presumably the basis for the increases in RT when the level of the target and search list are different. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
